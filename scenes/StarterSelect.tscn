[gd_scene load_steps=2 format=3]
[ext_resource type="Script" path="res://scripts/StarterSelect.gd" id="1"]
[node name="StarterSelect" type="Control"]
script = ExtResource("1")
[node name="VBox" type="VBoxContainer" parent="."]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -180
offset_top = -120
offset_right = 180
offset_bottom = 120
[node name="Label" type="Label" parent="VBox"]
text = "Wähle deinen Starter"
[node name="Choices" type="VBoxContainer" parent="VBox"]
[node name="S1" type="Button" parent="VBox/Choices"]
[node name="S2" type="Button" parent="VBox/Choices"]
[node name="S3" type="Button" parent="VBox/Choices"]
[connection signal="pressed" from="VBox/Choices/S1" to="." method="_on_s1_pressed"]
[connection signal="pressed" from="VBox/Choices/S2" to="." method="_on_s2_pressed"]
[connection signal="pressed" from="VBox/Choices/S3" to="." method="_on_s3_pressed"]
